# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Environment variables / secrets
.env

# Runtime data (generated by seed script / chatbot execution)
data/*.db
data/*.sqlite3
logs/*.log
logs/*.jsonl

# Keep folder structure tracked even though generated contents are ignored
!data/.gitkeep
!logs/.gitkeep

# Editor / OS
.DS_Store
.vscode/
.idea/

# Node (only relevant if the official MCP servers are vendored locally instead of via npx)
node_modules/
